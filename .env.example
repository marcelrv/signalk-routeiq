# Template for .env.local, which holds machine-local dev settings and is
# gitignored. Copy it, fill in your own values:
#
#   cp .env.example .env.local
#
# Nothing here is read by the plugin at runtime — it is dev tooling only.

# Signal K login for the screenshot harness (scripts/screenshots.sh). The
# plugin API is behind the server's own auth, so the harness cannot log in
# without these. An admin account is needed for the shots that open the
# plugin's Data Manager.
SK_USERNAME=
SK_PASSWORD=

# The Signal K server to drive. Defaults to http://localhost:3000.
#SK_URL=http://localhost:3000

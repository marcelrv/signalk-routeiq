# Force LF in the working tree on every platform.
#
# Without this, Windows CI runners check out with core.autocrlf converting LF
# to CRLF, and `prettier --check` (default endOfLine: "lf") then reports every
# source file as unformatted — the shared plugin-CI workflow's "Check
# formatting" step fails on Windows only, while Linux and macOS pass.
* text=auto eol=lf

# Vendored third-party assets stay byte-identical to what upstream published,
# so the download can still be checksum-verified when it is re-vendored
# (see public/vendor/README.md). leaflet.css ships with CRLF line endings and
# the eol=lf rule above would silently rewrite it.
public/vendor/*.js -text
public/vendor/*.css -text

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.svg text eol=lf
*.sqlite binary
*.sqlite.disabled binary
